<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %></title>
<meta name="description" content="<%= description %>">
<meta name="theme-color" content="#1E40AF">
<meta name="author" content="CMT AVENIR">
<meta name="robots" content="index, follow">

<% var baseUrl = (site && site.company && site.company.url) ? site.company.url.replace(/\/$/, '') : ''; %>
<% var canonical = baseUrl + (current || '/'); %>
<link rel="canonical" href="<%= canonical %>">

<meta property="og:type" content="website">
<meta property="og:site_name" content="<%= siteName %>">
<meta property="og:title" content="<%= title %>">
<meta property="og:description" content="<%= description %>">
<meta property="og:url" content="<%= canonical %>">
<meta property="og:image" content="<%= baseUrl %>/images/image1.jpg">
<meta property="og:locale" content="fr_FR">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= title %>">
<meta name="twitter:description" content="<%= description %>">
<meta name="twitter:image" content="<%= baseUrl %>/images/image1.jpg">

<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='20' fill='%231E40AF'/%3E%3Ctext x='50' y='70' font-size='58' font-family='Arial,sans-serif' font-weight='bold' text-anchor='middle' fill='%23F97316'%3EC%3C/text%3E%3C/svg%3E">
<link rel="apple-touch-icon" href="/images/apple-touch-icon.png">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css?v=<%= assetVersion %>">

<script type="application/ld+json">
<%- JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    name: site.company.name,
    description: site.company.tagline,
    url: baseUrl || undefined,
    telephone: site.company.phones[0],
    email: site.company.emails[0],
    address: { '@type': 'PostalAddress', addressLocality: site.company.address },
    image: (baseUrl || '') + '/images/image1.jpg'
}) %>
</script>
