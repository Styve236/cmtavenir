{
  "name": "cmt-avenir",
  "version": "1.0.0",
  "description": "Site officiel de CMT AVENIR - chaudronnerie, metallurgie et construction mecanique industrielle (Douala, Cameroun)",
  "private": true,
  "license": "MIT",
  "author": "CMT AVENIR",
  "scripts": {
    "postinstall": "npm --prefix functions install",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "lint": "node scripts/check-syntax.js",
    "emulators": "firebase emulators:start",
    "hash-password": "node scripts/hash-password.js",
    "seed": "node scripts/seed-partners.js",
    "images": "node scripts/optimize-images.js",
    "deploy": "firebase deploy",
    "deploy:hosting": "firebase deploy --only hosting",
    "deploy:functions": "firebase deploy --only functions"
  },
  "devDependencies": {
    "dotenv": "^16.4.5",
    "nodemon": "^3.1.7",
    "sharp": "^0.35.5"
  },
  "overrides": {
    "braces": "^3.0.3"
  }
}
