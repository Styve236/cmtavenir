rules_version = '2';

// Firestore est uniquement utilisé par le serveur (Cloud Functions via firebase-admin).
// Le navigateur n'a donc aucun accès direct : tout passe par l'API du site.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
