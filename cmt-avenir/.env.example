# ============================================================
#  CMT AVENIR — variables d'environnement
#  Copiez ce fichier en ".env" puis complétez les valeurs.
#  Le fichier .env ne doit JAMAIS être envoyé sur GitHub.
# ============================================================

# Clé de signature de la session admin (chaîne aléatoire longue).
# Génération : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Hash bcrypt du mot de passe administrateur.
# Génération : npm run hash-password -- "MonMotDePasse"
ADMIN_PASSWORD_HASH=

# Envoi du formulaire de contact par email (mot de passe d'application Gmail).
GMAIL_USER=
GMAIL_APP_PASSWORD=
CONTACT_TO=

# Relais de secours si l'email échoue (Formspree).
FORMSPREE_ENDPOINT=https://formspree.io/f/xjknrnwk

# Optionnel : forcer le port du serveur local (défaut : 3000)
# PORT=3000
